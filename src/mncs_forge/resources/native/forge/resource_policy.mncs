mncs 0.18;

module mncs.forge.resource_policy.v1;

// Canonical resource budget and admission decisions. Keeping these pure
// operations in a focused module also bounds the Stage-0 compatibility path
// used when the selected canonical VM reports an unsupported float operation.
enum ResourceBudgetStatus { Selected, Unavailable, InvalidPolicy }

record ResourceObservation {
    has_host_memory_total: bool,
    host_memory_total_bytes: i64,
    has_cgroup_memory_max: bool,
    cgroup_memory_max_bytes: i64
}

record ResourcePolicy {
    fields_valid: bool,
    has_memory_fraction: bool,
    memory_fraction: f64,
    has_memory_cap: bool,
    memory_cap_bytes: i64,
    has_memory_max: bool,
    memory_max_bytes: i64,
    has_tasks_max: bool,
    tasks_max: i64,
    has_concurrency_max: bool,
    concurrency_max: i64,
    has_runtime_max: bool,
    runtime_max_seconds: f64
}

record ResourceBudgetDecision {
    status: ResourceBudgetStatus,
    memory_high_bytes: i64,
    memory_max_bytes: i64,
    memory_swap_max_bytes: i64,
    tasks_max: i64,
    concurrency_max: i64,
    runtime_max_seconds: f64,
    effective_host_memory_bytes: i64
}

fn resource_min_i64(first: i64, second: i64) -> (result: i64) {
    if first < second { return first; }
    return second;
}

fn resource_max_i64(first: i64, second: i64) -> (result: i64) {
    if first > second { return first; }
    return second;
}

fn resource_capacity_select(
    has_host_memory: bool,
    host_memory: i64,
    has_cgroup_memory: bool,
    cgroup_memory: i64
) -> (result: i64) {
    if has_host_memory && has_cgroup_memory {
        return resource_min_i64(host_memory, cgroup_memory);
    }
    if has_host_memory { return host_memory; }
    return cgroup_memory;
}

fn resource_budget_empty(status: ResourceBudgetStatus) -> (result: ResourceBudgetDecision) {
    return ResourceBudgetDecision {
        status: status,
        memory_high_bytes: 0,
        memory_max_bytes: 0,
        memory_swap_max_bytes: 0,
        tasks_max: 0,
        concurrency_max: 0,
        runtime_max_seconds: 0.0,
        effective_host_memory_bytes: 0
    };
}

fn resource_budget_select(
    observation: ResourceObservation,
    policy: ResourcePolicy
) -> (result: ResourceBudgetDecision) {
    let default_memory_fraction: f64 = 0.15;
    let default_memory_cap: i64 = 4294967296;
    let default_tasks_max: i64 = 64;
    let default_concurrency_max: i64 = 1;
    let default_runtime_max: f64 = 600.0;
    let memory_fraction: f64 = select(policy.has_memory_fraction, policy.memory_fraction, default_memory_fraction);
    let memory_cap_bytes: i64 = select(policy.has_memory_cap, policy.memory_cap_bytes, default_memory_cap);
    let tasks_max: i64 = select(policy.has_tasks_max, policy.tasks_max, default_tasks_max);
    let concurrency_max: i64 = select(policy.has_concurrency_max, policy.concurrency_max, default_concurrency_max);
    let runtime_max_seconds: f64 = select(policy.has_runtime_max, policy.runtime_max_seconds, default_runtime_max);

    if !policy.fields_valid { return resource_budget_empty(ResourceBudgetStatus.InvalidPolicy); }
    if memory_fraction < 0.05 || memory_fraction > 0.25 {
        return resource_budget_empty(ResourceBudgetStatus.InvalidPolicy);
    }
    if memory_cap_bytes < 134217728 {
        return resource_budget_empty(ResourceBudgetStatus.InvalidPolicy);
    }
    if tasks_max < 1 || tasks_max > 4096 || concurrency_max != 1 {
        return resource_budget_empty(ResourceBudgetStatus.InvalidPolicy);
    }
    if runtime_max_seconds < 1.0 || runtime_max_seconds > 600.0 {
        return resource_budget_empty(ResourceBudgetStatus.InvalidPolicy);
    }

    let host_memory: i64 = select(observation.has_host_memory_total, observation.host_memory_total_bytes, 0);
    if !observation.has_host_memory_total && !observation.has_cgroup_memory_max {
        return resource_budget_empty(ResourceBudgetStatus.Unavailable);
    }
    let cgroup_memory: i64 = select(
        observation.has_cgroup_memory_max,
        observation.cgroup_memory_max_bytes,
        0
    );
    let capacity: i64 = resource_capacity_select(
        observation.has_host_memory_total,
        host_memory,
        observation.has_cgroup_memory_max,
        cgroup_memory
    );
    if capacity < 268435456 { return resource_budget_empty(ResourceBudgetStatus.Unavailable); }

    let derived_memory_max: i64 = resource_min_i64(
        ((capacity as f64) * memory_fraction) as i64,
        memory_cap_bytes
    );
    let requested_memory_max: i64 = select(policy.has_memory_max, policy.memory_max_bytes, derived_memory_max);
    let memory_max_bytes: i64 = resource_min_i64(requested_memory_max, derived_memory_max);
    if memory_max_bytes < 134217728 { return resource_budget_empty(ResourceBudgetStatus.Unavailable); }

    let memory_high_bytes: i64 = resource_min_i64(
        resource_max_i64(67108864, memory_max_bytes / 2),
        memory_max_bytes - 1
    );
    return ResourceBudgetDecision {
        status: ResourceBudgetStatus.Selected,
        memory_high_bytes: memory_high_bytes,
        memory_max_bytes: memory_max_bytes,
        memory_swap_max_bytes: 0,
        tasks_max: tasks_max,
        concurrency_max: concurrency_max,
        runtime_max_seconds: runtime_max_seconds,
        effective_host_memory_bytes: capacity
    };
}

fn resource_budget_identity(decision: ResourceBudgetDecision) -> (result: [byte; up_to 64])
    capability resource_budget_identity
    effect structured_digest authorized_by resource_budget_identity
{
    return structured_digest(decision);
}

// Admission is a separate typed decision over live observations. The host
// reads the cgroup and lock state; this function owns headroom, one-slot
// scheduling, and the effective wall deadline.
enum ResourceAdmissionStatus { Admit, Uncontained, Defer, Unavailable, InvalidInput }
enum ResourceAdmissionReason {
    None,
    ContainmentUnavailable,
    BudgetUnavailable,
    ProcessCountUnknown,
    ActiveProcessTree,
    ExecutionSlotOccupied,
    LowHostHeadroom,
    InvalidRuntime
}

record ResourceAdmissionObservation {
    containment_available: bool,
    has_budget: bool,
    has_available_memory: bool,
    available_memory_bytes: i64,
    has_host_available_memory: bool,
    host_available_memory_bytes: i64,
    has_cgroup_available_memory: bool,
    cgroup_available_memory_bytes: i64,
    active_tasks_known: bool,
    active_tasks: i64,
    execution_slot_available: bool,
    requested_runtime_seconds: f64
}

record ResourceAdmissionPolicy {
    containment_required: bool,
    memory_max_bytes: i64,
    concurrency_max: i64,
    runtime_max_seconds: f64
}

record ResourceAdmissionDecision {
    status: ResourceAdmissionStatus,
    reason: ResourceAdmissionReason,
    deferred: bool,
    required_headroom_bytes: i64,
    runtime_seconds: f64
}

fn resource_admission_min_f64(first: f64, second: f64) -> (result: f64) {
    if first < second { return first; }
    return second;
}

fn resource_admission_runtime_ceiling(runtime: f64) -> (result: f64) {
    return select(runtime > 0.0, runtime, 600.0);
}

fn resource_admission_effective_memory(observation: ResourceAdmissionObservation) -> (result: i64) {
    let fallback: i64 = select(
        observation.has_host_available_memory,
        observation.host_available_memory_bytes,
        select(
            observation.has_cgroup_available_memory,
            observation.cgroup_available_memory_bytes,
            observation.available_memory_bytes
        )
    );
    return select(
        observation.has_host_available_memory && observation.has_cgroup_available_memory,
        resource_min_i64(
            observation.host_available_memory_bytes,
            observation.cgroup_available_memory_bytes
        ),
        fallback
    );
}

fn resource_admission_decision(
    status: ResourceAdmissionStatus,
    reason: ResourceAdmissionReason,
    headroom: i64,
    runtime: f64
) -> (result: ResourceAdmissionDecision) {
    return ResourceAdmissionDecision {
        status: status,
        reason: reason,
        deferred: match status {
            Defer => true,
            Unavailable => true,
            Admit => false,
            Uncontained => false,
            InvalidInput => false
        },
        required_headroom_bytes: headroom,
        runtime_seconds: runtime
    };
}

fn resource_admission(
    observation: ResourceAdmissionObservation,
    policy: ResourceAdmissionPolicy
) -> (result: ResourceAdmissionDecision) {
    if observation.requested_runtime_seconds <= 0.0 {
        return resource_admission_decision(
            ResourceAdmissionStatus.InvalidInput,
            ResourceAdmissionReason.InvalidRuntime,
            0,
            0.0
        );
    }
    if !observation.containment_available {
        if policy.containment_required {
            return resource_admission_decision(
                ResourceAdmissionStatus.Unavailable,
                ResourceAdmissionReason.ContainmentUnavailable,
                0,
                0.0
            );
        }
        return resource_admission_decision(
            ResourceAdmissionStatus.Uncontained,
            ResourceAdmissionReason.None,
            0,
            resource_admission_min_f64(
                observation.requested_runtime_seconds,
                resource_admission_runtime_ceiling(policy.runtime_max_seconds)
            )
        );
    }
    if !observation.has_budget {
        if !policy.containment_required {
            return resource_admission_decision(
                ResourceAdmissionStatus.Uncontained,
                ResourceAdmissionReason.None,
                0,
                resource_admission_min_f64(
                    observation.requested_runtime_seconds,
                    resource_admission_runtime_ceiling(policy.runtime_max_seconds)
                )
            );
        }
        return resource_admission_decision(
            ResourceAdmissionStatus.Unavailable,
            ResourceAdmissionReason.BudgetUnavailable,
            0,
            0.0
        );
    }
    if policy.runtime_max_seconds <= 0.0 {
        return resource_admission_decision(
            ResourceAdmissionStatus.InvalidInput,
            ResourceAdmissionReason.InvalidRuntime,
            0,
            0.0
        );
    }
    if policy.memory_max_bytes <= 0 || policy.concurrency_max < 1 {
        return resource_admission_decision(
            ResourceAdmissionStatus.InvalidInput,
            ResourceAdmissionReason.None,
            0,
            0.0
        );
    }
    if !observation.execution_slot_available {
        return resource_admission_decision(
            ResourceAdmissionStatus.Defer,
            ResourceAdmissionReason.ExecutionSlotOccupied,
            0,
            0.0
        );
    }
    if !observation.active_tasks_known {
        return resource_admission_decision(
            ResourceAdmissionStatus.Unavailable,
            ResourceAdmissionReason.ProcessCountUnknown,
            0,
            0.0
        );
    }
    if observation.active_tasks < 0 {
        return resource_admission_decision(
            ResourceAdmissionStatus.InvalidInput,
            ResourceAdmissionReason.None,
            0,
            0.0
        );
    }
    if observation.active_tasks >= policy.concurrency_max {
        return resource_admission_decision(
            ResourceAdmissionStatus.Defer,
            ResourceAdmissionReason.ActiveProcessTree,
            0,
            0.0
        );
    }
    let doubled_memory: i64 = policy.memory_max_bytes * 2;
    let required_headroom: i64 = resource_max_i64(536870912, doubled_memory);
    let has_available_memory: bool = observation.has_available_memory
        || observation.has_host_available_memory
        || observation.has_cgroup_available_memory;
    let available_memory_bytes: i64 = resource_admission_effective_memory(observation);
    if has_available_memory && available_memory_bytes < required_headroom {
        return resource_admission_decision(
            ResourceAdmissionStatus.Defer,
            ResourceAdmissionReason.LowHostHeadroom,
            required_headroom,
            0.0
        );
    }
    return resource_admission_decision(
        ResourceAdmissionStatus.Admit,
        ResourceAdmissionReason.None,
        required_headroom,
        resource_admission_min_f64(
            observation.requested_runtime_seconds,
            policy.runtime_max_seconds
        )
    );
}

