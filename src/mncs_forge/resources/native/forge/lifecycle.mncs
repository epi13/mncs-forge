mncs 0.10;

// Bounded MNCS-native Forge lifecycle slice.
//
// This is a pure projection/transition kernel. It does not create records,
// persist a ledger, run a provider, or claim evaluator independence. The host
// application remains responsible for authority and custody boundaries.
module mncs.forge.lifecycle.v1;

use mncs.core.identity as idlib;
use mncs.core.lineage as linelib;
use mncs.core.status as statlib;

enum Stage {
    NoEpoch,
    EpochActive,
    CandidateRegistered,
    EvidenceIncomplete,
    CandidateReady,
    CandidateSelected,
    CandidateRejected,
    CandidateFrozen,
    EvaluationComplete,
    AmbiguousHistory
}

enum Operation {
    BeginEpoch,
    RegisterCandidate,
    AddEvidence,
    SelectCandidate,
    RejectCandidate,
    FreezeCandidate,
    RecordEvaluation
}

// A bounded history event is the typed input to the native projection. Empty
// slots are retained in the fixed array so the ABI never accepts an unbounded
// host collection or a dynamically interpreted JSON object.
enum EventKind {
    Empty,
    EpochStarted,
    CandidateRegistered,
    EvidenceObserved,
    CandidateSelected,
    CandidateRejected,
    CandidateFrozen,
    EvaluationRecorded
}

enum Disposition { Undisposed, Selected, Rejected, Conflict }

enum Freshness { NotApplicable, Current, Stale, Unknown }

record HistoryEvent {
    kind: EventKind,
    epoch: idlib.Digest32,
    parent_epoch: idlib.Digest32,
    candidate: idlib.Digest32,
    parent_candidate: idlib.Digest32,
    status: statlib.Status
}

record ProjectionInput {
    events: [HistoryEvent; 32],
    event_count: byte,
    current_candidate: idlib.Digest32,
    required_evidence: byte
}

record LifecycleState {
    stage: Stage,
    epoch: idlib.Digest32,
    candidate: idlib.Digest32,
    evidence: statlib.Status
}

record TransitionRequest {
    operation: Operation,
    epoch: idlib.Digest32,
    candidate: idlib.Digest32,
    evidence: statlib.Status
}

record TransitionResult { state: LifecycleState, status: statlib.Status, reason: byte }

record ProjectionState {
    stage: Stage,
    active_epoch: idlib.Digest32,
    parent_epoch: idlib.Digest32,
    current_candidate: idlib.Digest32,
    parent_candidate: idlib.Digest32,
    evidence: statlib.Status,
    disposition: Disposition,
    freshness: Freshness,
    lineage_ok: bool,
    epoch_count: i64,
    candidate_count: i64,
    evidence_count: i64,
    frozen: bool,
    evaluated: bool
}

record ProjectionResult { projection: ProjectionState, status: statlib.Status, reason: byte }

fn stage_code(value: Stage) -> (result: i64) {
    return match value {
        NoEpoch => 0,
        EpochActive => 1,
        CandidateRegistered => 2,
        EvidenceIncomplete => 3,
        CandidateReady => 4,
        CandidateSelected => 5,
        CandidateRejected => 6,
        CandidateFrozen => 7,
        EvaluationComplete => 8,
        AmbiguousHistory => 9,
    };
}

fn operation_code(value: Operation) -> (result: i64) {
    return match value {
        BeginEpoch => 0,
        RegisterCandidate => 1,
        AddEvidence => 2,
        SelectCandidate => 3,
        RejectCandidate => 4,
        FreezeCandidate => 5,
        RecordEvaluation => 6,
    };
}

fn status_code(value: statlib.Status) -> (result: i64) {
    return match value {
        PASS => 0,
        FAIL => 1,
        UNKNOWN => 2,
    };
}

fn state(stage: Stage, epoch: idlib.Digest32, candidate: idlib.Digest32, evidence: statlib.Status) -> (result: LifecycleState) {
    return LifecycleState { stage: stage, epoch: epoch, candidate: candidate, evidence: evidence };
}

fn initial() -> (result: LifecycleState) {
    return state(Stage.NoEpoch, idlib.zero(), idlib.zero(), statlib.Status.UNKNOWN);
}

fn request(operation: Operation, epoch: idlib.Digest32, candidate: idlib.Digest32, evidence: statlib.Status) -> (result: TransitionRequest) {
    return TransitionRequest { operation: operation, epoch: epoch, candidate: candidate, evidence: evidence };
}

fn outcome(next_state: LifecycleState, status_value: statlib.Status, reason: byte) -> (result: TransitionResult) {
    return TransitionResult { state: next_state, status: status_value, reason: reason };
}

fn rejected(current: LifecycleState, reason: byte) -> (result: TransitionResult) {
    return outcome(current, statlib.Status.FAIL, reason);
}

fn begin_epoch(current: LifecycleState, input: TransitionRequest) -> (result: TransitionResult) {
    if stage_code(current.stage) != 0 { return rejected(current, 2); }
    if idlib.is_zero(input.epoch) { return rejected(current, 1); }
    return outcome(state(Stage.EpochActive, input.epoch, idlib.zero(), statlib.Status.UNKNOWN), statlib.Status.PASS, 0);
}

fn register_candidate(current: LifecycleState, input: TransitionRequest) -> (result: TransitionResult) {
    if stage_code(current.stage) != 1 { return rejected(current, 4); }
    if idlib.is_zero(input.candidate) { return rejected(current, 3); }
    return outcome(state(Stage.CandidateRegistered, current.epoch, input.candidate, statlib.Status.UNKNOWN), statlib.Status.UNKNOWN, 0);
}

fn add_evidence(current: LifecycleState, input: TransitionRequest) -> (result: TransitionResult) {
    if stage_code(current.stage) != 2 && stage_code(current.stage) != 3 {
        return rejected(current, 7);
    }
    let combined: statlib.Status = statlib.dominate(current.evidence, input.evidence);
    return match combined {
        FAIL => outcome(state(Stage.CandidateRejected, current.epoch, current.candidate, statlib.Status.FAIL), statlib.Status.FAIL, 5),
        UNKNOWN => outcome(state(Stage.EvidenceIncomplete, current.epoch, current.candidate, statlib.Status.UNKNOWN), statlib.Status.UNKNOWN, 6),
        PASS => outcome(state(Stage.CandidateReady, current.epoch, current.candidate, statlib.Status.PASS), statlib.Status.PASS, 0),
    };
}

fn select_candidate(current: LifecycleState) -> (result: TransitionResult) {
    if stage_code(current.stage) != 4 || status_code(current.evidence) != 0 {
        return rejected(current, 8);
    }
    return outcome(state(Stage.CandidateSelected, current.epoch, current.candidate, statlib.Status.PASS), statlib.Status.PASS, 0);
}

fn reject_candidate(current: LifecycleState) -> (result: TransitionResult) {
    if stage_code(current.stage) != 2 && stage_code(current.stage) != 3 && stage_code(current.stage) != 4 {
        return rejected(current, 10);
    }
    return outcome(state(Stage.CandidateRejected, current.epoch, current.candidate, statlib.Status.FAIL), statlib.Status.FAIL, 9);
}

fn freeze_candidate(current: LifecycleState) -> (result: TransitionResult) {
    if stage_code(current.stage) != 5 { return rejected(current, 11); }
    return outcome(state(Stage.CandidateFrozen, current.epoch, current.candidate, statlib.Status.PASS), statlib.Status.PASS, 0);
}

fn record_evaluation(current: LifecycleState, input: TransitionRequest) -> (result: TransitionResult) {
    if stage_code(current.stage) != 7 { return rejected(current, 12); }
    let combined: statlib.Status = statlib.dominate(current.evidence, input.evidence);
    return outcome(state(Stage.EvaluationComplete, current.epoch, current.candidate, combined), combined, 0);
}

fn apply(current: LifecycleState, input: TransitionRequest) -> (result: TransitionResult) {
    if stage_code(current.stage) == 9 { return rejected(current, 90); }
    if operation_code(input.operation) != 0 {
        if idlib.equal(current.epoch, input.epoch) { } else { return rejected(current, 91); }
    }
    return match input.operation {
        Operation.BeginEpoch => begin_epoch(current, input),
        Operation.RegisterCandidate => register_candidate(current, input),
        Operation.AddEvidence => add_evidence(current, input),
        Operation.SelectCandidate => select_candidate(current),
        Operation.RejectCandidate => reject_candidate(current),
        Operation.FreezeCandidate => freeze_candidate(current),
        Operation.RecordEvaluation => record_evaluation(current, input),
    };
}

fn projection_initial() -> (result: ProjectionState) {
    return ProjectionState {
        stage: Stage.NoEpoch,
        active_epoch: idlib.zero(),
        parent_epoch: idlib.zero(),
        current_candidate: idlib.zero(),
        parent_candidate: idlib.zero(),
        evidence: statlib.Status.UNKNOWN,
        disposition: Disposition.Undisposed,
        freshness: Freshness.NotApplicable,
        lineage_ok: true,
        epoch_count: 0,
        candidate_count: 0,
        evidence_count: 0,
        frozen: false,
        evaluated: false
    };
}

fn invalid_projection(current: ProjectionState) -> (result: ProjectionState) {
    return ProjectionState {
        stage: Stage.AmbiguousHistory,
        active_epoch: current.active_epoch,
        parent_epoch: current.parent_epoch,
        current_candidate: current.current_candidate,
        parent_candidate: current.parent_candidate,
        evidence: current.evidence,
        disposition: current.disposition,
        freshness: Freshness.Unknown,
        lineage_ok: false,
        epoch_count: current.epoch_count,
        candidate_count: current.candidate_count,
        evidence_count: current.evidence_count,
        frozen: current.frozen,
        evaluated: current.evaluated
    };
}

fn project_epoch(current: ProjectionState, event: HistoryEvent) -> (result: ProjectionState) {
    if idlib.is_zero(event.epoch) { return invalid_projection(current); }
    if linelib.valid_root_or_successor(event.parent_epoch, current.active_epoch) { } else {
        return invalid_projection(current);
    }
    return ProjectionState {
        stage: Stage.EpochActive,
        active_epoch: event.epoch,
        parent_epoch: event.parent_epoch,
        current_candidate: idlib.zero(),
        parent_candidate: idlib.zero(),
        evidence: statlib.Status.UNKNOWN,
        disposition: Disposition.Undisposed,
        freshness: Freshness.NotApplicable,
        lineage_ok: current.lineage_ok,
        epoch_count: current.epoch_count +% 1,
        candidate_count: current.candidate_count,
        evidence_count: 0,
        frozen: false,
        evaluated: false
    };
}

fn project_candidate(current: ProjectionState, event: HistoryEvent) -> (result: ProjectionState) {
    if idlib.is_zero(current.active_epoch) || is_false(idlib.equal(event.epoch, current.active_epoch)) {
        return invalid_projection(current);
    }
    if idlib.is_zero(event.candidate) {
        return invalid_projection(current);
    }
    if idlib.equal(event.parent_candidate, event.candidate) {
        return invalid_projection(current);
    }
    if linelib.valid_root_or_successor(event.parent_candidate, current.current_candidate) { } else {
        return invalid_projection(current);
    }
    return ProjectionState {
        stage: Stage.CandidateRegistered,
        active_epoch: current.active_epoch,
        parent_epoch: current.parent_epoch,
        current_candidate: event.candidate,
        parent_candidate: event.parent_candidate,
        evidence: statlib.Status.UNKNOWN,
        disposition: Disposition.Undisposed,
        freshness: Freshness.Unknown,
        lineage_ok: current.lineage_ok,
        epoch_count: current.epoch_count,
        candidate_count: current.candidate_count +% 1,
        evidence_count: 0,
        frozen: false,
        evaluated: false
    };
}

fn is_undisposed(value: Disposition) -> (result: bool) {
    return match value {
        Disposition.Undisposed => true,
        Disposition.Selected => false,
        Disposition.Rejected => false,
        Disposition.Conflict => false,
    };
}

fn is_selected(value: Disposition) -> (result: bool) {
    return match value {
        Disposition.Undisposed => false,
        Disposition.Selected => true,
        Disposition.Rejected => false,
        Disposition.Conflict => false,
    };
}

fn is_pass(value: statlib.Status) -> (result: bool) {
    return match value {
        statlib.Status.PASS => true,
        statlib.Status.FAIL => false,
        statlib.Status.UNKNOWN => false,
    };
}

fn is_false(value: bool) -> (result: bool) {
    if value { return false; }
    return true;
}

fn join_evidence(current: ProjectionState, observed: statlib.Status) -> (result: statlib.Status) {
    if current.evidence_count == 0 { return observed; }
    return statlib.dominate(current.evidence, observed);
}

fn project_evidence(current: ProjectionState, event: HistoryEvent) -> (result: ProjectionState) {
    if idlib.is_zero(current.current_candidate) { return invalid_projection(current); }
    if idlib.equal(event.candidate, current.current_candidate) { } else {
        return invalid_projection(current);
    }
    // Evidence observed after disposition is legitimate revalidation input:
    // freeze re-runs required checks after selection, and the readiness
    // kernel plus host authorization decide whether it blocks. Disposition
    // itself is unchanged here, so recorded terminal dispositions are never
    // rewritten by later observations. Post-freeze and post-evaluation
    // observations remain outside the lifecycle.
    if current.frozen { return invalid_projection(current); }
    if current.evaluated { return invalid_projection(current); }
    let combined: statlib.Status = join_evidence(current, event.status);
    return ProjectionState {
        stage: Stage.EvidenceIncomplete,
        active_epoch: current.active_epoch,
        parent_epoch: current.parent_epoch,
        current_candidate: current.current_candidate,
        parent_candidate: current.parent_candidate,
        evidence: combined,
        disposition: current.disposition,
        freshness: current.freshness,
        lineage_ok: current.lineage_ok,
        epoch_count: current.epoch_count,
        candidate_count: current.candidate_count,
        evidence_count: current.evidence_count +% 1,
        frozen: current.frozen,
        evaluated: current.evaluated
    };
}

fn project_selected(current: ProjectionState, event: HistoryEvent) -> (result: ProjectionState) {
    if idlib.equal(event.candidate, current.current_candidate) { } else {
        return invalid_projection(current);
    }
    if is_undisposed(current.disposition) { } else { return invalid_projection(current); }
    // History projection accepts a recorded selection without re-proving
    // evidence sufficiency. Selection authorization (readiness kernel plus
    // host evidence gates) happens at record time, while projected history
    // slices legitimately omit evidence kinds (evaluator views). Evidence
    // stays visible in the projected state for status derivation below.
    return ProjectionState {
        stage: Stage.CandidateSelected,
        active_epoch: current.active_epoch,
        parent_epoch: current.parent_epoch,
        current_candidate: current.current_candidate,
        parent_candidate: current.parent_candidate,
        evidence: current.evidence,
        disposition: Disposition.Selected,
        freshness: current.freshness,
        lineage_ok: current.lineage_ok,
        epoch_count: current.epoch_count,
        candidate_count: current.candidate_count,
        evidence_count: current.evidence_count,
        frozen: current.frozen,
        evaluated: current.evaluated
    };
}

fn project_rejected(current: ProjectionState, event: HistoryEvent) -> (result: ProjectionState) {
    if idlib.equal(event.candidate, current.current_candidate) { } else {
        return invalid_projection(current);
    }
    if is_undisposed(current.disposition) { } else { return invalid_projection(current); }
    return ProjectionState {
        stage: Stage.CandidateRejected,
        active_epoch: current.active_epoch,
        parent_epoch: current.parent_epoch,
        current_candidate: current.current_candidate,
        parent_candidate: current.parent_candidate,
        evidence: statlib.Status.FAIL,
        disposition: Disposition.Rejected,
        freshness: current.freshness,
        lineage_ok: current.lineage_ok,
        epoch_count: current.epoch_count,
        candidate_count: current.candidate_count,
        evidence_count: current.evidence_count,
        frozen: current.frozen,
        evaluated: current.evaluated
    };
}

fn project_frozen(current: ProjectionState, event: HistoryEvent) -> (result: ProjectionState) {
    if idlib.equal(event.candidate, current.current_candidate) { } else {
        return invalid_projection(current);
    }
    if is_selected(current.disposition) { } else { return invalid_projection(current); }
    if current.frozen { return invalid_projection(current); }
    return ProjectionState {
        stage: Stage.CandidateFrozen,
        active_epoch: current.active_epoch,
        parent_epoch: current.parent_epoch,
        current_candidate: current.current_candidate,
        parent_candidate: current.parent_candidate,
        evidence: current.evidence,
        disposition: current.disposition,
        freshness: current.freshness,
        lineage_ok: current.lineage_ok,
        epoch_count: current.epoch_count,
        candidate_count: current.candidate_count,
        evidence_count: current.evidence_count,
        frozen: true,
        evaluated: current.evaluated
    };
}

fn project_evaluation(current: ProjectionState, event: HistoryEvent) -> (result: ProjectionState) {
    if idlib.equal(event.candidate, current.current_candidate) { } else {
        return invalid_projection(current);
    }
    if is_selected(current.disposition) { } else { return invalid_projection(current); }
    if is_false(current.frozen) { return invalid_projection(current); }
    if current.evaluated { return invalid_projection(current); }
    return ProjectionState {
        stage: Stage.EvaluationComplete,
        active_epoch: current.active_epoch,
        parent_epoch: current.parent_epoch,
        current_candidate: current.current_candidate,
        parent_candidate: current.parent_candidate,
        evidence: join_evidence(current, event.status),
        disposition: current.disposition,
        freshness: current.freshness,
        lineage_ok: current.lineage_ok,
        epoch_count: current.epoch_count,
        candidate_count: current.candidate_count,
        evidence_count: current.evidence_count,
        frozen: current.frozen,
        evaluated: true
    };
}

fn project_event(current: ProjectionState, event: HistoryEvent) -> (result: ProjectionState) {
    return match event.kind {
        EventKind.Empty => current,
        EventKind.EpochStarted => project_epoch(current, event),
        EventKind.CandidateRegistered => project_candidate(current, event),
        EventKind.EvidenceObserved => project_evidence(current, event),
        EventKind.CandidateSelected => project_selected(current, event),
        EventKind.CandidateRejected => project_rejected(current, event),
        EventKind.CandidateFrozen => project_frozen(current, event),
        EventKind.EvaluationRecorded => project_evaluation(current, event),
    };
}

fn undisposed_stage(current: ProjectionState, required_evidence: byte) -> (result: Stage) {
    if current.evidence_count == 0 { return Stage.CandidateRegistered; }
    if is_pass(current.evidence) && current.evidence_count >= (required_evidence as i64) {
        return Stage.CandidateReady;
    }
    return Stage.EvidenceIncomplete;
}

fn project_stage(current: ProjectionState, required_evidence: byte) -> (result: Stage) {
    if is_false(current.lineage_ok) { return Stage.AmbiguousHistory; }
    if idlib.is_zero(current.active_epoch) { return Stage.NoEpoch; }
    if idlib.is_zero(current.current_candidate) { return Stage.EpochActive; }
    if current.evaluated { return Stage.EvaluationComplete; }
    if current.frozen { return Stage.CandidateFrozen; }
    return match current.disposition {
        Disposition.Selected => Stage.CandidateSelected,
        Disposition.Rejected => Stage.CandidateRejected,
        Disposition.Conflict => Stage.AmbiguousHistory,
        Disposition.Undisposed => undisposed_stage(current, required_evidence),
    };
}

fn selected_status(evidence: statlib.Status) -> (result: statlib.Status) {
    // A recorded selection reports PASS only when PASS evidence is actually
    // present in the projected slice; evaluator views omit evidence kinds.
    if is_pass(evidence) { return statlib.Status.PASS; }
    return statlib.Status.UNKNOWN;
}

fn project_status(stage: Stage, evidence: statlib.Status) -> (result: statlib.Status) {
    return match stage {
        Stage.NoEpoch => statlib.Status.UNKNOWN,
        Stage.EpochActive => statlib.Status.UNKNOWN,
        Stage.CandidateRegistered => statlib.Status.UNKNOWN,
        Stage.CandidateRejected => statlib.Status.FAIL,
        Stage.EvidenceIncomplete => evidence,
        Stage.CandidateReady => statlib.Status.PASS,
        Stage.CandidateSelected => selected_status(evidence),
        Stage.CandidateFrozen => selected_status(evidence),
        Stage.EvaluationComplete => evidence,
        Stage.AmbiguousHistory => statlib.Status.UNKNOWN,
    };
}

fn project_events(input: ProjectionInput, initial: ProjectionState) -> (result: ProjectionState) {
    if (input.event_count as i64) > 32 { return invalid_projection(initial); }
    let events: [HistoryEvent; 32] = input.events;
    iterate i over input.events carrying state: ProjectionState = initial {
        let active: bool = (i as i64) < (input.event_count as i64);
        let event: HistoryEvent = events[i];
        next state = project_event_if_active(state, event, active);
    }
    return state;
}

fn project_freshness(current: ProjectionState, input: ProjectionInput) -> (result: Freshness) {
    if idlib.is_zero(current.current_candidate) { return Freshness.NotApplicable; }
    if idlib.equal(current.current_candidate, input.current_candidate) {
        return Freshness.Current;
    }
    return Freshness.Stale;
}

fn project_reason(current: ProjectionState, input: ProjectionInput) -> (result: byte) {
    if (input.event_count as i64) > 32 { return 91; }
    if is_false(current.lineage_ok) { return 90; }
    return 0;
}

fn project_event_if_active(current: ProjectionState, event: HistoryEvent, active: bool) -> (result: ProjectionState) {
    if active { return project_event(current, event); }
    return current;
}

fn project(input: ProjectionInput) -> (result: ProjectionResult) {
    let initial: ProjectionState = projection_initial();
    let projected: ProjectionState = project_events(input, initial);
    let freshness: Freshness = project_freshness(projected, input);
    let stage: Stage = project_stage(projected, input.required_evidence);
    let final_state: ProjectionState = ProjectionState {
        stage: stage,
        active_epoch: projected.active_epoch,
        parent_epoch: projected.parent_epoch,
        current_candidate: projected.current_candidate,
        parent_candidate: projected.parent_candidate,
        evidence: projected.evidence,
        disposition: projected.disposition,
        freshness: freshness,
        lineage_ok: projected.lineage_ok,
        epoch_count: projected.epoch_count,
        candidate_count: projected.candidate_count,
        evidence_count: projected.evidence_count,
        frozen: projected.frozen,
        evaluated: projected.evaluated
    };
    let reason: byte = project_reason(projected, input);
    return ProjectionResult {
        projection: final_state,
        status: project_status(stage, projected.evidence),
        reason: reason
    };
}
