{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-forge-mcp/schemas/mncs-forge-config.schema.json",
  "title": "MNCS Forge project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "paths", "limits", "authority", "policies", "workflows"],
  "properties": {
    "version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identity", "root"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/relativeRoot"}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "generated", "contracts", "references", "evaluators", "acceptance_policies", "development_evidence", "protected", "outputs"],
      "properties": {
        "candidates": {"$ref": "#/$defs/pathList"},
        "generated": {"$ref": "#/$defs/pathList"},
        "contracts": {"$ref": "#/$defs/pathList"},
        "references": {"$ref": "#/$defs/pathList"},
        "evaluators": {"$ref": "#/$defs/pathList"},
        "acceptance_policies": {"$ref": "#/$defs/pathList"},
        "development_evidence": {"$ref": "#/$defs/pathList"},
        "protected": {"$ref": "#/$defs/pathList"},
        "outputs": {"$ref": "#/$defs/pathList"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "output_bytes"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
        "output_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216}
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["off", "prefer", "required"],
          "default": "prefer"
        }
      }
    },
    "verifier_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_batch": {"type": "integer", "minimum": 1, "maximum": 32},
        "request_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "batch_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
        "witness_bytes": {"type": "integer", "minimum": 256, "maximum": 1048576},
        "stderr_bytes": {"type": "integer", "minimum": 256, "maximum": 1048576},
        "result_bytes": {"type": "integer", "minimum": 2048, "maximum": 4194304},
        "max_changed_paths": {"type": "integer", "minimum": 1, "maximum": 1024},
        "max_dependency_identities": {"type": "integer", "minimum": 1, "maximum": 1024},
        "max_question_parameters": {"type": "integer", "minimum": 0, "maximum": 128}
      }
    },
    "runner": {
      "type": "object",
      "description": "Optional execution-runner selection. The default local-process runner preserves historical behavior.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["local-process", "podman-rootless"],
          "default": "local-process"
        },
        "podman_path": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "writable_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "tmpfs_size": {"type": "string", "pattern": "^[0-9]+[kmgte]?$"},
        "memory": {"type": "string", "pattern": "^[0-9]+[kmgte]?$"},
        "cpus": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "pids_limit": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mncs": {"$ref": "#/$defs/command"},
        "mncds": {"$ref": "#/$defs/command"},
        "mncs_test": {"$ref": "#/$defs/command"},
        "mncs_debug": {"$ref": "#/$defs/command"},
        "ravel_impact": {"$ref": "#/$defs/command"}
      }
    },
    "environment_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
    "required_capabilities": {"$ref": "#/$defs/stringList"},
    "rights_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["observe", "advisory", "enforced"]},
        "manifest": {"$ref": "#/$defs/relativePath"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "evaluator"],
      "properties": {
        "development": {
          "type": "object",
          "additionalProperties": false,
          "required": ["may_write_candidates", "may_write_generated", "may_run_providers"],
          "properties": {
            "may_write_candidates": {"type": "boolean"},
            "may_write_generated": {"type": "boolean"},
            "may_run_providers": {"type": "boolean"}
          }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_read_only", "authority_read_only", "require_frozen_identities", "withhold_repair_feedback"],
          "properties": {
            "candidate_read_only": {"const": true},
            "authority_read_only": {"const": true},
            "require_frozen_identities": {"const": true},
            "withhold_repair_feedback": {"const": true}
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "useful_benefit_objective"],
      "properties": {
        "selection": {"$ref": "#/$defs/relativePath"},
        "useful_benefit_objective": {"$ref": "#/$defs/relativePath"}
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "name": {"type": "string", "minLength": 1},
          "identity": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "command": {"$ref": "#/$defs/command"},
          "transport": {"const": "stdio-jsonl"},
          "required": {"type": "boolean"},
          "capabilities": {"$ref": "#/$defs/stringList"},
          "supported_constructs": {"$ref": "#/$defs/stringList"},
          "unsupported_constructs": {"$ref": "#/$defs/stringList"},
          "limitations": {"$ref": "#/$defs/stringList"},
          "executable_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "descriptor": {"$ref": "#/$defs/relativePath"},
          "environment": {"type": "object", "additionalProperties": {"type": "string"}},
          "module_roots": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "python_packages": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          }
        }
      }
    },
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "workflow", "provider", "method", "claim", "category", "modes", "scopes", "input_kinds", "cost"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "version": {"type": "string", "pattern": ".*\\S.*", "maxLength": 128},
          "workflow": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "method": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "claim": {"type": "string", "pattern": ".*\\S.*", "maxLength": 2048},
          "category": {"enum": ["build", "compiler_matrix", "differential_behavior", "mutation", "sanitizers", "bounded_structural_analysis", "resource_checks", "checkpoint_recovery", "benchmark", "evidence_derivation", "mncs_bundle_validation", "mncds_record_validation", "inspection"]},
          "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["development", "evaluator"]}},
          "languages": {"$ref": "#/$defs/stringList"},
          "artifact_types": {"$ref": "#/$defs/stringList"},
          "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["region", "function", "file", "module", "package", "candidate", "contract", "artifact", "evidence", "dependency-slice"]}},
          "input_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["candidate_identity", "changed_paths", "source_region", "contract_identity", "dependency_slice_identities", "prior_artifact_identity", "question_parameters"]}},
          "limitations": {"$ref": "#/$defs/stringList"},
          "assumptions": {"$ref": "#/$defs/stringList"},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
          "cost": {"enum": ["low", "medium", "high"]},
          "uncertainty_classes": {"$ref": "#/$defs/stringList"},
          "tags": {"$ref": "#/$defs/stringList"},
          "parameter_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "not": {"enum": ["shared", "by_verifier"]}}},
          "disclosure": {"enum": ["compact", "status-only"]}
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "mode", "command", "provider_protocol"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "category": {"enum": ["build", "compiler_matrix", "differential_behavior", "mutation", "sanitizers", "bounded_structural_analysis", "resource_checks", "checkpoint_recovery", "benchmark", "evidence_derivation", "mncs_bundle_validation", "mncds_record_validation", "inspection"]},
          "mode": {"enum": ["development", "evaluator", "both"]},
          "command": {"$ref": "#/$defs/command"},
          "provider_protocol": {"type": "boolean"},
          "provider_id": {"type": "string"},
          "subject": {"enum": ["candidate", "project"]},
          "environment": {"type": "object", "additionalProperties": {"type": "string"}},
          "disclosure": {"enum": ["compact", "status-only"]}
        }
      }
    }
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"},
    "relativeRoot": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\u0000).+$"},
    "pathList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
    "stringList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
