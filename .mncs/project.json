      {"path": "src/mncs_forge/mncs_native.py", "class": "host-boundary", "note": "Compiler/process adapter for native Forge providers.", "classification": {"authority": "none", "lifecycle": "active", "boundary_kind": "process", "semantic_role": "platform-adapter"}},
